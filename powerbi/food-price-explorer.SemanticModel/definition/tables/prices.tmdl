table prices
	lineageTag: a0b3c1b8-db48-4e46-892e-9a161ec9ea06

	measure 'Median Price' = CALCULATE ( MEDIAN ( prices[price_per_unit_local] ), prices[exclude] = FALSE (), prices[is_main_unit] = TRUE (), prices[pricetype] = "Retail" )
		formatString: #,0
		lineageTag: 2cda9afd-a43f-45d6-a167-b6bbe778363c

	measure 'Median Price USD' = CALCULATE ( MEDIAN ( prices[price_per_unit_usd] ), prices[exclude] = FALSE (), prices[is_main_unit] = TRUE (), prices[pricetype] = "Retail" )
		formatString: $#,0.00
		lineageTag: 8b7ab3f0-3c4e-496f-9bd5-87884a64a665

	measure 'Latest Month' = CALCULATE ( MAX ( prices[month] ), ALLSELECTED ( dates ), prices[exclude] = FALSE () )
		formatString: mmm yyyy
		lineageTag: 388215fc-00a7-4dc0-9b67-48187ee347b5

	measure 'Price Latest' = VAR lm = [Latest Month] RETURN CALCULATE ( [Median Price], REMOVEFILTERS ( dates ), dates[month] = lm )
		formatString: #,0
		lineageTag: 1ec05b6a-d6dc-4eb8-a076-f6e53da225d1

	measure 'Price 12M Ago' = VAR lm = [Latest Month] RETURN CALCULATE ( [Median Price], REMOVEFILTERS ( dates ), dates[month] = EDATE ( lm, -12 ) )
		formatString: #,0
		lineageTag: 8ee62929-43f3-41ce-9a9c-3a7fc040584e

	measure 'Change 12M %' = VAR a = [Price 12M Ago] RETURN DIVIDE ( [Price Latest] - a, a )
		formatString: +0%;-0%;0%
		lineageTag: c688995c-16cb-4c39-916b-870ba1b36df5

	measure 'Price Jan 2020' = CALCULATE ( [Median Price], REMOVEFILTERS ( dates ), dates[month] = DATE ( 2020, 1, 1 ) )
		formatString: #,0
		lineageTag: 1cb0b7f8-c5f7-4e4d-9438-a45c6ab91e3f

	measure 'Change Since 2020 %' = DIVIDE ( [Price Latest] - [Price Jan 2020], [Price Jan 2020] )
		formatString: +0%;-0%;0%
		lineageTag: 6c3c1ed7-ec1b-48b4-bde3-10b86329f739

	measure 'Markets Reporting' = CALCULATE ( DISTINCTCOUNT ( prices[market_id] ), prices[pricetype] = "Retail", prices[exclude] = FALSE () )
		formatString: #,0
		lineageTag: df5b3599-f3a0-4948-a774-632a4944b21c

	measure Records = COUNTROWS ( prices )
		formatString: #,0
		lineageTag: e66367b5-e282-4594-bee1-d888e152df0f

	measure 'Market Max Price' = MAXX ( VALUES ( markets[market_id] ), [Median Price] )
		formatString: #,0
		lineageTag: 91eb01a4-f3d6-4431-8b66-99f668914e2d

	measure 'Market Min Price' = MINX ( VALUES ( markets[market_id] ), [Median Price] )
		formatString: #,0
		lineageTag: 91439668-30e1-4005-9a07-bfd544755d1b

	measure 'Market Spread %' = DIVIDE ( [Market Max Price] - [Market Min Price], [Market Min Price] )
		formatString: 0%
		lineageTag: a763bb22-a2a1-4e1f-b8be-9de107ab2383

	measure 'Price Index (Jan 2020 = 100)' = DIVIDE ( [Median Price], [Price Jan 2020] ) * 100
		formatString: #,0
		lineageTag: 57cd7f2f-7216-4c91-a060-0469ae66cab5

	measure 'Price Index USD (Jan 2020 = 100)' = DIVIDE ( [Median Price USD], CALCULATE ( [Median Price USD], REMOVEFILTERS ( dates ), dates[month] = DATE ( 2020, 1, 1 ) ) ) * 100
		formatString: #,0
		lineageTag: c4a8043c-572d-4c03-807d-bbd7ee872fcf

	measure 'Latest Month Label' = FORMAT ( [Latest Month], "mmm yyyy" )
		lineageTag: 2d25e9c4-3573-4fcd-a525-e1bb54cc90cf

	measure 'Unit Label' = CALCULATE ( MAX ( prices[std_unit] ), prices[is_main_unit] = TRUE () )
		lineageTag: be234742-fca3-484a-b7ff-dceb78a45b96

	measure 'Trend Title' = SELECTEDVALUE ( prices[commodity_group], "Selected food" ) & ": median retail price, ₦ per " & [Unit Label]
		lineageTag: 547e74bd-fc2b-4f5f-bebf-cb3ecbd9ca7f

	measure 'KPI Latest Title' = "Latest price, ₦ per " & [Unit Label] & " (" & [Latest Month Label] & ")"
		lineageTag: 7d6ea6b6-3354-4079-bfe9-3e7f2e6bac10

	measure 'Markets Latest' = VAR lm = [Latest Month] RETURN CALCULATE ( [Markets Reporting], REMOVEFILTERS ( dates ), dates[month] = lm )
		formatString: #,0
		lineageTag: 2d20bdb9-a61a-4701-af00-22094eb3ea4f

	measure 'Market Price Latest' = VAR lm = CALCULATE ( [Latest Month], ALLSELECTED ( markets ) ) RETURN CALCULATE ( [Median Price], REMOVEFILTERS ( dates ), dates[month] = lm )
		formatString: #,0
		lineageTag: 220ef7eb-5f18-4849-8df8-7499c19ffbd5

	measure 'Market Max Latest' = MAXX ( VALUES ( markets[market_id] ), [Market Price Latest] )
		formatString: #,0
		lineageTag: 6a2a355f-81ca-436d-93bf-df93a6417d8b

	measure 'Market Min Latest' = MINX ( VALUES ( markets[market_id] ), [Market Price Latest] )
		formatString: #,0
		lineageTag: a65b4ce7-9ce5-4327-a36e-3b86713a8635

	measure 'Market Spread Latest %' = DIVIDE ( [Market Max Latest] - [Market Min Latest], [Market Min Latest] )
		formatString: 0%
		lineageTag: a4a07181-804f-4d03-9837-8dbae1fa5ac2

	measure 'Map Title' = SELECTEDVALUE ( prices[commodity_group], "Selected food" ) & " by market, ₦ per " & [Unit Label] & " (" & FORMAT ( CALCULATE ( [Latest Month], ALLSELECTED ( markets ) ), "mmm yyyy" ) & ")"
		lineageTag: e854da82-cd5a-4c24-99e6-7be9a0c6be3a

	measure 'Change Since 2020 USD %' = VAR lm = [Latest Month] VAR a = CALCULATE ( [Median Price USD], REMOVEFILTERS ( dates ), dates[month] = lm ) VAR b = CALCULATE ( [Median Price USD], REMOVEFILTERS ( dates ), dates[month] = DATE ( 2020, 1, 1 ) ) RETURN DIVIDE ( a - b, b )
		formatString: +0%;-0%;0%
		lineageTag: 34b9e36b-291e-4e54-a2f0-8ee588fc7368

	measure 'Tooltip Title' = SELECTEDVALUE ( markets[market], "Market" ) & ", " & SELECTEDVALUE ( markets[state] ) & ": ₦ per " & [Unit Label] & ", " & FORMAT ( CALCULATE ( [Latest Month], ALLSELECTED ( markets ) ), "mmm yyyy" )

