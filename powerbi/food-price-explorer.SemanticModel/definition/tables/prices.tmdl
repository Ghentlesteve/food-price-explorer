	partition prices = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "prices.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"month", type date}, {"country", type text}, {"zone", type text}, {"state", type text}, {"lga", type text}, {"market", type text}, {"market_id", Int64.Type}, {"category", type text}, {"commodity", type text}, {"commodity_group", type text}, {"pricetype", type text}, {"unit", type text}, {"unit_qty", type number}, {"std_unit", type text}, {"currency", type text}, {"price_local", type number}, {"price_usd", type number}, {"price_per_unit_local", type number}, {"price_per_unit_usd", type number}, {"is_main_unit", type logical}, {"is_aggregate", type logical}, {"exclude", type logical}, {"exclude_reason", type text}}, "en-US")
				in
					Typed

