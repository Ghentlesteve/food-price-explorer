	partition commodities = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "commodities.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"commodity", type text}, {"category", type text}, {"commodity_group", type text}, {"main_unit", type text}, {"countries", type text}}, "en-US")
				in
					Typed

